# ============================================================
# Signal-Foundry Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- LLM Providers ---
# OpenRouter (primary for: openai/gpt-5.5, anthropic/claude-opus-4.7, google/gemini-3.1-pro-preview)
OPENROUTER_API_KEY=sk-or-v1-xxx

# NVIDIA AI Endpoints (primary for: moonshotai/kimi-k2.6, z-ai/glm-5.1, deepseek-ai/deepseek-v4-pro, minimaxai/minimax-m2.7)
NVIDIA_API_KEY=nvapi-xxx

# Default model (used when no model specified)
DEFAULT_MODEL=openai/gpt-5.5

# --- GitHub (Task 1: CI/CD Skills) ---
GITHUB_TOKEN=github_pat_xxx

# --- LangSmith (optional: tracing & eval) ---
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_PROJECT=signal-foundry
LANGSMITH_TRACING=true

# --- SEC EDGAR (Task 3) ---
SEC_USER_AGENT=signal-foundry/1.0 (contact@example.com)
SEC_CACHE_DIR=/tmp/signal_foundry_sec_cache
SEC_MAX_DOWNLOAD_MB=200
SEC_REQUEST_TIMEOUT_SEC=120

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Cost Discipline ---
MAX_COST_PER_REQUEST_USD=2.00
MAX_TOKENS_PER_REQUEST=100000
